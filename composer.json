{
  "name": "dotmarn/mailcheckr-php",
  "description": "Laravel client for the MailCheckr email verification API",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/dotmarn/mailcheckr-php",
  "authors": [
    {
      "name": "Ridwan Kasim",
      "email": "kasimsheyi20@gmail.com",
      "role": "Owner"
    }
  ],
  "keywords": ["mailcheckr", "laravel", "email verification"],
  "require": {
    "php": "^8.2",
    "illuminate/container": "^10.0 || ^11.0 || ^12.0 || ^13.0",
    "illuminate/http": "^10.0 || ^11.0 || ^12.0 || ^13.0",
    "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0"
  },
  "require-dev": {"phpunit/phpunit": "^11.5 || ^12.0"},
  "autoload": {"psr-4": {"Dotmarn\\MailCheckr\\": "src/"}},
  "scripts": {"test": "phpunit"},
  "extra": {"laravel": {"providers": ["Dotmarn\\MailCheckr\\MailCheckrServiceProvider"], "aliases": {"MailCheckr": "Dotmarn\\MailCheckr\\Facades\\MailCheckr"}}},
  "prefer-stable": true
}
